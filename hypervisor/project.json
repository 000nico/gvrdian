{
  "langrev": "1",
  "warnings": [ "no-unused" ],
  "authors": [ "Nicolas Carlinos <nicolascarlino@proton.me>" ],
  "version": "0.1.0",

  "sources": [
    "src/**",
    "sdk/**",
    "libs/ctypes.c3",
    "libs/wdm.c3"
  ],

  "build-dir": "build",
  "output": "build",

  "targets": {
    "gvrdian": {
      "type": "object-files",
      "use-stdlib": false,
      "link-libc": false,
      "no-entry": true,
      "safe": false,
      "target": "windows-x64",
      "opt": "O0",
      "debug-info": "none",

      // Repeat sources here so the LSP picks them up per-target
      "sources": [
        "src/**",
        "sdk/**",
        "libs/**"
      ]
    }
  },

  "cpu": "generic",
  "opt": "O0"
}